generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clinic {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  logoUrl      String?
  timezone     String        @default("Asia/Baku")
  settings     Json          @default("{}")
  doctors      Doctor[]
  services     Service[]
  appointments Appointment[]
  leads        Lead[]
  users        AdminUser[]
  createdAt    DateTime      @default(now())
}

model AdminUser {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())

  @@index([clinicId])
}

model Doctor {
  id                String        @id @default(cuid())
  clinicId          String
  clinic            Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name              String
  specialty         String
  photoUrl          String?
  availabilityRules Json
  appointments      Appointment[]
  createdAt         DateTime      @default(now())

  @@index([clinicId])
}

model Service {
  id              String        @id @default(cuid())
  clinicId        String
  clinic          Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  price           Decimal       @db.Decimal(10, 2)
  durationMinutes Int
  iconName        String?
  appointments    Appointment[]
  createdAt       DateTime      @default(now())

  @@index([clinicId])
}

model Appointment {
  id             String            @id @default(cuid())
  clinicId       String
  clinic         Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctorId       String
  doctor         Doctor            @relation(fields: [doctorId], references: [id])
  serviceId      String
  service        Service           @relation(fields: [serviceId], references: [id])
  patientName    String
  patientPhone   String
  startTime      DateTime
  endTime        DateTime
  status         AppointmentStatus @default(PENDING)
  priceAtBooking Decimal           @db.Decimal(10, 2)
  notes          String?
  notifications  NotificationLog[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([clinicId, startTime])
  @@index([clinicId, status])
  @@index([doctorId, startTime])
}

model Lead {
  id        String     @id @default(cuid())
  clinicId  String
  clinic    Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  message   String?
  source    String     @default("website_widget")
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())

  @@index([clinicId])
}

model NotificationLog {
  id            String             @id @default(cuid())
  appointmentId String
  appointment   Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  type          NotificationType
  status        NotificationStatus @default(PENDING)
  messageText   String
  retryCount    Int                @default(0)
  errorMessage  String?
  sentAt        DateTime?
  createdAt     DateTime           @default(now())

  @@index([appointmentId, type])
  @@index([status])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  NO_SHOW
  COMPLETED
}

enum LeadStatus {
  NEW
  CONTACTED
}

enum NotificationType {
  BOOKING_CONFIRMATION
  REMINDER_24H
  REMINDER_2H
  CANCELLATION
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
}
