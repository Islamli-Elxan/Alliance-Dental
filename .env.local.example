# ============================================================
# NEXGEN DENTAL — .env.local
# Bu faylı .env.local olaraq köçürün və real dəyərlərlə doldurun
# cp .env.local.example .env.local
# ============================================================

# --- Database (Neon.tech) ---
# 1. neon.tech-də pulsuz hesab açın
# 2. Yeni layihə yaradın (region: EU-West-1 daha yaxındır)
# 3. Connection String -> "Pooled connection" -> kopyalayın
# Format: postgresql://user:pass@ep-xxx-pooler.region.neon.tech/dbname?sslmode=require
DATABASE_URL=""

# --- NextAuth ---
# Generate komandası (terminalda işlədin):
#   openssl rand -base64 32
NEXTAUTH_SECRET=""
# Localhost üçün: http://localhost:3000
# Production üçün: https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# --- Green API (WhatsApp) ---
# 1. green-api.com -> Sign up
# 2. Yeni instance yaradın (Personal plan kifayətdir)
# 3. Instance ID və API Token kopyalayın
# 4. WhatsApp aplikasiyası ilə QR scan edib instance-ı authorize edin
GREEN_API_INSTANCE_ID=""
GREEN_API_TOKEN=""
GREEN_API_BASE_URL="https://api.green-api.com"

# --- App ---
# Klinika slug (DB-də mövcud olmalıdır - seed default: "alliance")
NEXT_PUBLIC_CLINIC_SLUG="alliance"

# Vercel Cron secret (yenə openssl rand ilə yaradın)
CRON_SECRET=""
